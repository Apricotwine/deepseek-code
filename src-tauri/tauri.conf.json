{
    "productName": "DeepSeek Code",
    "version": "0.1.0",
    "identifier": "com.deepseek.code",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "DeepSeek Code",
                "width": 1400,
                "height": 900,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "dmg"
        ],
        "category": "DeveloperTool",
        "shortDescription": "DeepSeek-native coding desktop workstation",
        "longDescription": "A coding workstation built for DeepSeek V4 \u2014 1M context window, thinking-chain replay, native prompt caching, streaming task pipeline.",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns"
        ],
        "macOS": {
            "minimumSystemVersion": "10.15"
        },
        "resources": [
            "../harness-runtime",
            "../harness/persona.md",
            "../harness/time-awareness.md",
            "../harness/tal-tool-result.mjs",
            "../harness/presets"
        ],
        "externalBin": [
            "binaries/node"
        ]
    },
    "plugins": {
        "shell": {
            "open": true
        }
    }
}
